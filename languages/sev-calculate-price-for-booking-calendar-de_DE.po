#. Plugin Name of the plugin
#: sev-calculate-price-for-booking-calendar.php
msgid "SEV Calculate Price for Booking Calendar"
msgstr "SEV Calculate Price for Booking Calendar"

#. Description of the plugin
#: sev-calculate-price-for-booking-calendar.php
msgid "Calculates and displays the booking price for Booking Calendar (WPBC) based on the number of selected days and configurable per-day price tiers, filling the [cost_hint] shortcode that Booking Calendar Free leaves inactive."
msgstr "Berechnet und zeigt den Buchungspreis für Booking Calendar (WPBC) basierend auf der Anzahl der ausgewählten Tage und konfigurierbaren Preisstufen pro Tag an und füllt damit den [cost_hint]-Shortcode, den Booking Calendar Free inaktiv lässt."

#. Author of the plugin
#: sev-calculate-price-for-booking-calendar.php
msgid "sevmatic"
msgstr "sevmatic"

#. Author URI of the plugin
#: sev-calculate-price-for-booking-calendar.php
msgid "https://sevmatic.com"
msgstr "https://sevmatic.com"


#. Plugin Name of the plugin
#: sev-calculate-price-for-booking-calendar.php
msgid "SEV Calculate Price for Booking Calendar"
msgstr ""

#. Description of the plugin
#: sev-calculate-price-for-booking-calendar.php
msgid "Calculates and displays the booking price and deposit for Booking Calendar (WPBC) based on the number of selected days, configurable per-day price tiers, and a fixed or percentage-based deposit, filling the [cost_hint] and [deposit_hint] shortcodes that Booking Calendar Free leaves inactive."
msgstr ""

